OPENAI_API_KEY=sk-replace-me

# Optional: biasing prompt for Whisper (online + offline). Helps disambiguate
# accented English from Malay/Indonesian when language auto-detection is wrong.
# Leave empty to disable. Example:
# WHISPER_INITIAL_PROMPT="The following is English speech, sometimes mixed with Malay or Mandarin technical terms."
WHISPER_INITIAL_PROMPT=

# Optional: default OpenRouter model used by user-defined AI Actions when
# their per-action model field is left blank. Falls back to the same default
# used by the grammar fixer if unset.
OPENROUTER_ACTION_DEFAULT_MODEL=

# Optional: override the location of clipboard_actions.json (the unified
# launcher config). Defaults to the project root next to main.py.
CLIPBOARD_ACTIONS_PATH=

# Browser to pull cookies from when YouTube blocks us with the "Sign in to
# confirm you're not a bot" gate. Leave blank by default; the app will prompt
# and fill this in for you the first time it's needed.
# Supported: chrome, edge, firefox, brave, opera, vivaldi, chromium, safari.
YOUTUBE_COOKIE_BROWSER=
# Optional: specific browser profile name. For Chrome the directory name on
# disk is "Profile N" — check chrome://version → "Profile Path".
YOUTUBE_COOKIE_PROFILE=
# Manual cookies.txt fallback (Netscape format). Preferred over live browser
# extraction because it avoids Chrome's locked-DB issue (yt-dlp #7271) and
# Chrome 127+ app-bound encryption (yt-dlp #10927). Export from Chrome with
# the "Get cookies.txt LOCALLY" extension. Defaults to
#   secrets/youtube_cookies.txt
# next to this .env when left blank.
YOUTUBE_COOKIES_FILE=

# HTTP API server — exposes every shortcut over REST so other machines
# (e.g. a VM without a GPU) can call the host's features programmatically.
LAUNCHER_API_ENABLED=1
LAUNCHER_API_HOST=0.0.0.0
LAUNCHER_API_PORT=8009
# Optional bearer token. Blank = no auth (LAN trust). Set to a long random
# string to require Authorization: Bearer <token> on every request except /healthz.
LAUNCHER_API_TOKEN=

# Voice re-speaker (Ctrl+Alt+5) + Type → cloned voice (Ctrl+Alt+6):
#   record / type → edge-tts (base voice) → RVC voice clone → play.
#
# The settings below act as the FALLBACK / NEW-HOTKEY defaults. As of the
# advanced-voice-settings panel, each hotkey can override most of these on
# a per-hotkey basis via the popup window; per-hotkey values are persisted
# in clipboard_actions.json and take precedence over what's set here.
#
# Drop your RVC model files in models/respeaker/ (one .pth, one optional .index).
RESPEAKER_MODEL_PATH=models/respeaker/voice.pth
RESPEAKER_INDEX_PATH=models/respeaker/voice.index
# edge-tts base voice — controls language, accent, and gender baseline.
# Examples: en-US-JennyNeural, es-ES-ElviraNeural, ja-JP-NanamiNeural.
# The popup window has a curated language-grouped picker for this.
RESPEAKER_BASE_VOICE=en-US-JennyNeural
# Semitone shift applied during RVC. Use -12 to drop an octave (female base → male target).
RESPEAKER_PITCH=0
# Accent-mix strength from the .index file. 0.75 is a good default; raise to 0.9
# for stronger character accent, lower for more neutral delivery.
RESPEAKER_INDEX_RATE=0.75
# Torch device. "cuda:0" requires a CUDA-capable GPU + matching torch wheel.
# Not exposed in the popup — change here if you need to force CPU.
RESPEAKER_DEVICE=cuda:0
# Pitch extraction algorithm: rmvpe (recommended, GPU), fcpe, crepe, harvest, pm, dio
RESPEAKER_F0_METHOD=rmvpe
